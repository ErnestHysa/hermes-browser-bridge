<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Fix #P1-5: Uses $HOME environment variable for portable path.
       Before: /Users/ernest/Desktop/DEVPROJECTS/...
       After:  $HOME/Desktop/DEVPROJECTS/... (portable across users) -->
  <key>Label</key>
  <string>com.hermes-agent.browser-bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "$HOME/Desktop/DEVPROJECTS/hermes-browser-bridge/proxy_server" && node server.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/hermes-browser-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hermes-browser-bridge.error.log</string>

  <!--
    Install:
      cp launchd/com.hermes-agent.browser-bridge.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.hermes-agent.browser-bridge.plist

    Uninstall:
      launchctl unload ~/Library/LaunchAgents/com.hermes-agent.browser-bridge.plist
      rm ~/Library/LaunchAgents/com.hermes-agent.browser-bridge.plist
  -->
</dict>
</plist>
